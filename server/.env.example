PORT=8080

# Room cleanup delay (ms)
ROOM_GRACE_MS=10000

# Room reservation timeout (ms)
ROOM_RESERVATION_MS=300000

# Clerk secret key (same Clerk project as the frontend)
CLERK_SECRET_KEY=<your-clerk-secret-key>

# Minimum connection time before saving a room (ms)
MEMBER_MIN_CONNECTED_MS=60000

# Maximum wait for pending snapshot writes on shutdown (ms)
SNAPSHOT_FLUSH_MS=20000

# Snapshot write rate limit
SNAPSHOT_WRITE_LIMIT=60
SNAPSHOT_WRITE_WINDOW_MS=60000

# Database connection timeout (ms)
DB_CONNECT_TIMEOUT_MS=10000

# Neon Postgres (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full