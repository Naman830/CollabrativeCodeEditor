PORT=8080

# How long an emptied room lingers before it is destroyed, in ms. Non-zero so the
# last person in a room can refresh without deleting it out from under themselves.
ROOM_GRACE_MS=10000

# How long a created-but-never-entered room stays claimable, in ms.
ROOM_RESERVATION_MS=300000

# Postgres (Neon), for the dead-room snapshot written when a room is destroyed.
# Use the *pooled* endpoint — the host containing `-pooler` — and keep
# `?sslmode=require`; Neon refuses plaintext connections.
#
# Optional. Leave it unset and the server still boots and serves rooms exactly
# as it does in v1: db.js simply never opens a pool and saveDeadRoom() is a
# no-op. Nothing about the live room — sync, presence, eviction — depends on it.
#
# Note this server never runs migrations, so it has no DIRECT_URL counterpart;
# the schema is owned by collab-code-editor/prisma/schema.prisma.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
