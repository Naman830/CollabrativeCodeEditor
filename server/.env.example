PORT=8080

# How long an emptied room lingers before it is destroyed, in ms. Non-zero so the
# last person in a room can refresh without deleting it out from under themselves.
ROOM_GRACE_MS=10000

# How long a created-but-never-entered room stays claimable, in ms.
ROOM_RESERVATION_MS=300000

# --- Dead-room snapshots (task 7.3) ------------------------------------------

# Clerk secret key, used ONLY to verify the session token a client sends on the
# WebSocket URL. tasks.md §6.1 is emphatic that a snapshot's owners must come
# from a token the server checked, never from awareness — awareness is
# peer-controlled, so a forged account ID would write a room's code into a
# stranger's profile.
#
# Optional. Unset, no token is ever verified, no room ever has members, and no
# snapshot is ever written — exactly v1's behaviour. Verification never refuses a
# socket either way, so Clerk being down or misconfigured can never make a room
# unjoinable.
#
# Must be the SAME Clerk instance as the frontend's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
# A dev key here against a production frontend fails every token with no visible
# symptom at all: rooms work, and snapshots simply never appear.
CLERK_SECRET_KEY=<your-clerk-secret-key>

# How long a signed-in participant must be connected before they earn a copy of
# the room on /profile, in ms. Paired with "did they actually edit anything" —
# the timer alone is passed by anyone who leaves a tab open, which is the lurker
# case tasks.md §6.1 exists to prevent.
MEMBER_MIN_CONNECTED_MS=60000

# How long a shutdown waits for in-flight snapshot writes, in ms. A ceiling, not
# a delay — it resolves as soon as the writes land. Keep it above
# DB_CONNECT_TIMEOUT_MS and under the platform's SIGTERM-to-SIGKILL grace.
#
# Note this now bounds a *drain*, not a single batch: snapshotQueue.js writes at
# most db.js's POOL_MAX at a time, so N queued rooms take
# ceil(N / POOL_MAX) x per-write. Measured ~6.6s for 40 rooms against a warm
# Neon branch, so 20s covers a redeploy comfortably.
SNAPSHOT_FLUSH_MS=20000

# --- Snapshot write pacing (task 7.5) ----------------------------------------

# How many dead-room snapshots one caller may have written per window, keyed on
# the IP that created the room. tasks.md §7.5 asks for DB writes to be limited
# "the same way v1 rate-limits room creation" — same sliding window, same key.
#
# It DEFERS rather than refuses: an over-limit snapshot waits its turn instead of
# being dropped, because refusing one would destroy the only copy of somebody's
# work to protect a database. Nothing is discarded except on the queue's own
# memory bounds, and a shutdown bypasses pacing entirely.
#
# Deliberately 60, not the 10 that POST /rooms uses. Room creation is already
# capped at 10/min/IP and a snapshot additionally needs a signed-in member who
# stayed MEMBER_MIN_CONNECTED_MS *and* edited, so 10 here would almost never bind
# on abuse — while binding constantly on a shared NAT (one office or classroom
# egress IP closing thirty rooms at once), holding those snapshots in memory for
# minutes for no benefit.
#
# Lower both of these to exercise the deferral path in seconds during testing.
SNAPSHOT_WRITE_LIMIT=60
SNAPSHOT_WRITE_WINDOW_MS=60000

# How long a single Postgres connection attempt may take, in ms. The pool is
# always cold at SIGTERM and Neon autosuspends an idle branch, so this has to
# cover waking a database, not just a TLS handshake: measured ~750-900ms warm but
# over 5s against a suspended branch.
DB_CONNECT_TIMEOUT_MS=10000

# Postgres (Neon), for the dead-room snapshot written when a room is destroyed.
# Use the *pooled* endpoint — the host containing `-pooler`.
#
# Prefer `?sslmode=verify-full` over the `?sslmode=require` Neon hands you.
# node-postgres currently treats `require` as an alias for `verify-full`, but
# warns that pg v9 will switch it to libpq semantics — which do NOT verify the
# certificate. Writing verify-full pins the strong behaviour so a routine
# dependency bump cannot quietly downgrade TLS.
#
# Optional. Leave it unset and the server still boots and serves rooms exactly
# as it does in v1: db.js simply never opens a pool and saveDeadRoom() is a
# no-op. Nothing about the live room — sync, presence, eviction — depends on it.
#
# Note this server never runs migrations, so it has no DIRECT_URL counterpart;
# the schema is owned by web/prisma/schema.prisma.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
