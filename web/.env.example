# WebSocket sync server URL
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Clerk authentication keys
# Get these from your Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Postgres (pooled) - Used by the app
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Neon Postgres (direct) - Used for Prisma migrations
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

# How many proxy hops in front of this process to trust in x-forwarded-for.
# The rate-limit key is read right-most-minus-(hops-1): the address the closest trusted proxy
# observed. 1 is correct for Railway and Vercel; raise it only if a CDN sits in front, and set
# 0 to ignore the header entirely (direct connections only). An over-count degrades to the
# left-most value rather than to a wrong bucket.
TRUSTED_PROXY_HOPS=1
